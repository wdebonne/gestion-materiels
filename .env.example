# Configuration de l'application
NODE_ENV=development
PORT=3001
HOST=localhost

# URL du frontend (pour CORS)
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=votre_secret_jwt_tres_long_et_securise_a_changer_en_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Base de données (sqlite ou mysql)
DB_TYPE=sqlite
DB_PATH=./data/database.sqlite

# Configuration MySQL/MariaDB (si DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=gestion_materiels

# Pile Docker MySQL (docker-compose.mysql.yml)
# Le serveur MySQL y est un conteneur : MYSQL_HOST et MYSQL_PORT ci-dessus ne le
# concernent pas, la pile vise le service `db` d'elle-même. Les deux mots de
# passe sont obligatoires, sans eux la pile refuse de démarrer.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_USER=gestion
MYSQL_APP_PASSWORD=
# Port publié sur l'hôte : 3001 est déjà pris par la pile SQLite
MYSQL_APP_PORT=3002

# Configuration SMTP (à configurer dans l'interface)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Configuration du site
SITE_NAME=Gestion Matériels
SITE_URL=http://localhost:3001
SITE_VERSION=1.0.0

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Sécurité
BCRYPT_ROUNDS=12

# Clé Google Maps (facultative)
# Sans elle, les cartes s'affichent via OpenStreetMap et les vues Street View
# sont masquées. Une clé publique était auparavant codée en dur dans le source.
VITE_GOOGLE_MAPS_KEY=
