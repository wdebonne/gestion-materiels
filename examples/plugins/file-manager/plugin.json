{
  "name": "Gestionnaire de fichiers",
  "slug": "file-manager",
  "version": "1.0.0",
  "description": "Gérez tous les fichiers stockés sur le serveur : documents, images, PDF et autres fichiers.",
  "author": "System",
  "icon": "Folder",
  "type": "menu",
  "route": "files",
  "config": {
    "maxFileSize": 52428800,
    "allowedTypes": ["*"],
    "enableVersioning": false
  },
  "database": {
    "tables": [
      {
        "name": "plugin_files",
        "columns": [
          { "name": "id", "type": "INTEGER", "primaryKey": true, "autoIncrement": true },
          { "name": "filename", "type": "VARCHAR(255)", "notNull": true },
          { "name": "original_name", "type": "VARCHAR(255)", "notNull": true },
          { "name": "mime_type", "type": "VARCHAR(100)" },
          { "name": "extension", "type": "VARCHAR(20)" },
          { "name": "size", "type": "INTEGER" },
          { "name": "folder", "type": "VARCHAR(255)", "default": "''" },
          { "name": "category_id", "type": "INTEGER", "foreignKey": { "table": "categories", "column": "id", "onDelete": "SET NULL" } },
          { "name": "object_id", "type": "INTEGER", "foreignKey": { "table": "objects", "column": "id", "onDelete": "SET NULL" } },
          { "name": "tags", "type": "TEXT" },
          { "name": "description", "type": "TEXT" },
          { "name": "download_count", "type": "INTEGER", "default": "0" },
          { "name": "created_at", "type": "DATETIME", "default": "CURRENT_TIMESTAMP" },
          { "name": "updated_at", "type": "DATETIME", "default": "CURRENT_TIMESTAMP" },
          { "name": "created_by", "type": "INTEGER" }
        ]
      },
      {
        "name": "plugin_file_folders",
        "columns": [
          { "name": "id", "type": "INTEGER", "primaryKey": true, "autoIncrement": true },
          { "name": "name", "type": "VARCHAR(100)", "notNull": true },
          { "name": "parent_id", "type": "INTEGER", "foreignKey": { "table": "plugin_file_folders", "column": "id", "onDelete": "CASCADE" } },
          { "name": "path", "type": "VARCHAR(500)" },
          { "name": "created_at", "type": "DATETIME", "default": "CURRENT_TIMESTAMP" }
        ]
      }
    ]
  },
  "api": {
    "endpoints": [
      {
        "method": "GET",
        "path": "/list",
        "query": "SELECT pf.*, c.name as category_name, o.name as object_name FROM plugin_files pf LEFT JOIN categories c ON c.id = pf.category_id LEFT JOIN objects o ON o.id = pf.object_id ORDER BY pf.created_at DESC",
        "description": "Liste tous les fichiers"
      },
      {
        "method": "GET",
        "path": "/folders",
        "query": "SELECT * FROM plugin_file_folders ORDER BY path",
        "description": "Liste les dossiers"
      },
      {
        "method": "GET",
        "path": "/by-folder/:folder",
        "query": "SELECT * FROM plugin_files WHERE folder = :folder ORDER BY original_name",
        "description": "Fichiers par dossier"
      },
      {
        "method": "GET",
        "path": "/by-extension/:ext",
        "query": "SELECT * FROM plugin_files WHERE extension = :ext ORDER BY created_at DESC",
        "description": "Fichiers par extension"
      },
      {
        "method": "GET",
        "path": "/search",
        "query": "SELECT * FROM plugin_files WHERE original_name LIKE '%' || :q || '%' OR tags LIKE '%' || :q || '%' ORDER BY created_at DESC",
        "description": "Recherche de fichiers"
      },
      {
        "method": "GET",
        "path": "/stats",
        "query": "SELECT COUNT(*) as total, SUM(size) as total_size, COUNT(DISTINCT extension) as extensions FROM plugin_files",
        "description": "Statistiques"
      },
      {
        "method": "DELETE",
        "path": "/:id",
        "query": "DELETE FROM plugin_files WHERE id = :id",
        "description": "Supprime un fichier"
      }
    ]
  },
  "pages": {
    "index": {
      "title": "Gestionnaire de fichiers",
      "layout": "default",
      "components": [
        {
          "type": "header",
          "title": "Gestionnaire de fichiers",
          "subtitle": "Parcourez, recherchez et gérez vos fichiers",
          "actions": [
            { "label": "Ajouter un fichier", "action": "upload", "icon": "Upload", "variant": "primary" },
            { "label": "Nouveau dossier", "action": "newFolder", "icon": "FolderPlus", "variant": "outline" }
          ]
        },
        {
          "type": "stats",
          "items": [
            { "label": "Fichiers", "source": "total", "icon": "File", "color": "bg-blue-100 text-blue-600" },
            { "label": "Espace utilisé", "source": "total_size", "icon": "HardDrive", "color": "bg-purple-100 text-purple-600", "format": "filesize" },
            { "label": "Types", "source": "extensions", "icon": "FileType", "color": "bg-green-100 text-green-600" }
          ]
        },
        {
          "type": "filters",
          "fields": [
            { "name": "search", "label": "Rechercher", "type": "text", "placeholder": "Nom, tags..." },
            { "name": "type", "label": "Type", "type": "select", "options": [
              { "value": "", "label": "Tous" },
              { "value": "pdf", "label": "PDF" },
              { "value": "doc,docx", "label": "Word" },
              { "value": "xls,xlsx", "label": "Excel" },
              { "value": "jpg,jpeg,png,gif", "label": "Images" },
              { "value": "zip,rar,7z", "label": "Archives" }
            ]},
            { "name": "category", "label": "Catégorie", "type": "select", "source": "categories" }
          ]
        },
        {
          "type": "dataTable",
          "source": "/list",
          "emptyMessage": "Aucun fichier trouvé. Cliquez sur 'Ajouter un fichier' pour commencer.",
          "columns": [
            { "field": "icon", "type": "fileIcon", "width": 40 },
            { "field": "original_name", "label": "Nom", "sortable": true },
            { "field": "extension", "label": "Type", "width": 80 },
            { "field": "size", "label": "Taille", "format": "filesize", "sortable": true },
            { "field": "category_name", "label": "Catégorie" },
            { "field": "download_count", "label": "Téléchargements", "sortable": true },
            { "field": "created_at", "label": "Date", "format": "date", "sortable": true }
          ],
          "actions": [
            { "icon": "Download", "action": "download", "tooltip": "Télécharger" },
            { "icon": "Eye", "action": "preview", "tooltip": "Aperçu" },
            { "icon": "Edit", "action": "edit", "tooltip": "Modifier" },
            { "icon": "Trash2", "action": "delete", "tooltip": "Supprimer", "confirm": true }
          ]
        }
      ]
    }
  }
}
