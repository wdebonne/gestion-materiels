{
  "name": "Amortissement",
  "slug": "depreciation",
  "version": "1.0.0",
  "description": "Calcul de la dépréciation et valeur résiduelle du matériel",
  "author": "Système",
  "icon": "trending-down",
  "type": "menu",
  "route": "depreciation",
  "config": {
    "default_lifespan_years": 5,
    "depreciation_method": "linear",
    "available_lifespans": [3, 5, 7, 10, 15]
  },
  "api": {
    "endpoints": [
      {
        "method": "GET",
        "path": "/data",
        "query": "SELECT o.id, o.name, o.reference, c.name as categoryName, o.purchase_price as purchasePrice, o.purchase_date as purchaseDate FROM objects o LEFT JOIN categories c ON o.category_id = c.id WHERE o.purchase_price IS NOT NULL AND o.purchase_price > 0 AND o.purchase_date IS NOT NULL ORDER BY o.name ASC",
        "description": "Données d'amortissement des matériels"
      }
    ]
  },
  "pages": {
    "index": {
      "title": "Amortissement",
      "layout": "default",
      "components": [
        {
          "type": "header",
          "title": "Amortissement",
          "subtitle": "Calcul de la dépréciation et valeur résiduelle des matériels"
        },
        {
          "type": "stats",
          "items": [
            {
              "label": "Matériels suivis",
              "source": "totalItems",
              "icon": "Package",
              "color": "bg-blue-100 text-blue-600"
            },
            {
              "label": "Valeur d'achat totale",
              "source": "totalPurchaseValue",
              "icon": "DollarSign",
              "color": "bg-green-100 text-green-600",
              "format": "currency"
            },
            {
              "label": "Valeur résiduelle",
              "source": "totalResidualValue",
              "icon": "TrendingDown",
              "color": "bg-orange-100 text-orange-600",
              "format": "currency"
            },
            {
              "label": "Entièrement amortis",
              "source": "fullyDepreciatedCount",
              "icon": "AlertTriangle",
              "color": "bg-red-100 text-red-600"
            }
          ]
        },
        {
          "type": "chart",
          "chartType": "pie",
          "title": "Répartition Valeur résiduelle / Amortissement",
          "data": [
            { "name": "Valeur résiduelle", "key": "totalResidualValue", "color": "#22c55e" },
            { "name": "Amortissement", "key": "totalDepreciation", "color": "#ef4444" }
          ]
        },
        {
          "type": "chart",
          "chartType": "bar",
          "title": "Top 10 matériels par valeur résiduelle",
          "source": "topByValue",
          "bars": [
            { "dataKey": "residualValue", "name": "Valeur résiduelle", "color": "#22c55e" },
            { "dataKey": "totalDepreciation", "name": "Amortissement", "color": "#ef4444" }
          ]
        },
        {
          "type": "dataTable",
          "source": "/api/dashboard/depreciation",
          "emptyMessage": "Aucun matériel avec données d'amortissement.",
          "columns": [
            { "field": "name", "label": "Matériel", "sortable": true },
            { "field": "categoryName", "label": "Catégorie", "sortable": true },
            { "field": "purchasePrice", "label": "Prix d'achat", "format": "currency", "sortable": true },
            { "field": "ageInYears", "label": "Âge (années)", "sortable": true },
            { "field": "residualValue", "label": "Valeur résiduelle", "format": "currency", "sortable": true },
            { "field": "depreciationPercent", "label": "% Amorti", "format": "percent", "sortable": true },
            { "field": "isFullyDepreciated", "label": "Statut", "type": "badge" }
          ]
        }
      ]
    }
  }
}
